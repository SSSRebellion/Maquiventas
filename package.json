{
  "name": "maqui-ventas-react-vite",
  "version": "2.0.0",
  "description": "Sistema web para la gestión y comercialización de maquinaria pesada con React, Vite, Carrito de Compras, Pasarela de Pagos e Historial de Pedidos",
  "main": "src/js/app.js",
  "scripts": {
    "build": "node build_standalone.js",
    "dev": "node server.js",
    "start": "node server.js",
